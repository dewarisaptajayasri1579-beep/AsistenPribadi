generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String     @id @default(uuid())
  name                   String
  email                  String     @unique
  timezone               String     @default("Asia/Jakarta")
  role                   String     @default("Direktur")
  assistantInstructions  String?    @map("assistant_instructions")
  notifyAgenda           Boolean    @default(true) @map("notify_agenda")
  notifyDailyReport      Boolean    @default(true) @map("notify_daily_report")
  notifyPriorityAlert    Boolean    @default(true) @map("notify_priority_alert")
  notifyMorningBriefing  Boolean    @default(true) @map("notify_morning_briefing")
  tasks                  Task[]
  schedules              Schedule[]
  followUps              FollowUp[]
  agentRuns              AgentRun[]
  aiUsageLogs            AiUsageLog[]

  @@map("users")
}

model Task {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  priority    String    @default("normal") // low | normal | high
  status      String    @default("todo") // todo | in_progress | done | postponed
  category    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id])

  @@map("tasks")
}

model Schedule {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  title    String
  startAt  DateTime  @map("start_at")
  endAt    DateTime? @map("end_at")
  location String?
  notes    String?
  status   String    @default("confirmed")
  user     User      @relation(fields: [userId], references: [id])

  @@map("schedules")
}

model FollowUp {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  title         String
  relatedPerson String?   @map("related_person")
  dueDate       DateTime? @map("due_date")
  status        String    @default("open") // open | done | overdue
  notes         String?
  user          User      @relation(fields: [userId], references: [id])

  @@map("follow_ups")
}

model AgentRun {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  command     String
  agentAction String   @map("agent_action")
  result      String?
  status      String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("agent_runs")
}

model AiUsageLog {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  command             String
  model               String
  inputTokens         Int      @default(0) @map("input_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  apiCallCount        Int      @default(1) @map("api_call_count")
  estimatedCostUsd    Decimal  @db.Decimal(12, 8) @map("estimated_cost_usd")
  durationMs          Int      @map("duration_ms")
  createdAt           DateTime @default(now()) @map("created_at")
  user                User     @relation(fields: [userId], references: [id])

  @@map("ai_usage_logs")
}
