generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String       @id @default(uuid())
  name                   String
  email                  String       @unique
  passwordHash           String?      @map("password_hash")
  phoneNumber            String?      @map("phone_number")
  isOwner                Boolean      @default(false) @map("is_owner")
  timezone               String       @default("Asia/Jakarta")
  role                   String       @default("Direktur")
  assistantInstructions  String?      @map("assistant_instructions")
  notifyAgenda           Boolean      @default(true) @map("notify_agenda")
  notifyDailyReport      Boolean      @default(true) @map("notify_daily_report")
  notifyPriorityAlert    Boolean      @default(true) @map("notify_priority_alert")
  notifyMorningBriefing  Boolean      @default(true) @map("notify_morning_briefing")
  createdAt              DateTime     @default(now()) @map("created_at")
  tasks                  Task[]
  schedules              Schedule[]
  followUps              FollowUp[]
  agentRuns              AgentRun[]
  aiUsageLogs            AiUsageLog[]
  sessions               Session[]
  pushSubscriptions      PushSubscription[]
  recurringSchedules     RecurringSchedule[]
  whatsappThread         WhatsappThread?

  @@map("users")
}

/// Konteks percakapan AI Agent per nomor WhatsApp — supaya pertanyaan lanjutan ("ya hapus
/// saja") tetap nyambung walau tiap webhook WAHUB masuk sebagai request terpisah. Direset
/// otomatis kalau sudah idle lama (lihat WHATSAPP_THREAD_IDLE_MS di lib/whatsapp-webhook.ts).
model WhatsappThread {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  history   Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_threads")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Task {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  startDate   DateTime? @map("start_date")
  dueDate     DateTime? @map("due_date")
  priority    String    @default("normal") // low | normal | high
  status      String    @default("todo") // todo | in_progress | done | postponed
  category    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id])

  @@map("tasks")
}

model Schedule {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  title        String
  startAt      DateTime           @map("start_at")
  endAt        DateTime?          @map("end_at")
  location     String?
  notes        String?
  status       String             @default("confirmed")
  remindedAt   DateTime?          @map("reminded_at")
  checkinAt    DateTime?          @map("checkin_at")
  recurrenceId String?            @map("recurrence_id")
  user         User               @relation(fields: [userId], references: [id])
  recurrence   RecurringSchedule? @relation(fields: [recurrenceId], references: [id])

  @@map("schedules")
}

/// Definisi jadwal rutin/berulang (mis. "tiap Senin & Kamis") — kejadian aslinya tetap
/// disimpan sebagai baris Schedule biasa (recurrenceId menunjuk ke sini) supaya reminder,
/// cek bentrok, dan briefing tidak perlu tahu soal konsep recurrence sama sekali.
model RecurringSchedule {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  title        String
  weekdays     Int[] // ISO weekday: 1=Senin ... 7=Minggu
  startTime    String     @map("start_time") // "HH:mm" Asia/Jakarta
  endTime      String?    @map("end_time")
  location     String?
  notes        String?
  active       Boolean    @default(true)
  horizonUntil DateTime   @map("horizon_until") // sudah dibuatkan Schedule sampai tanggal ini
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id])
  schedules    Schedule[]

  @@map("recurring_schedules")
}

model FollowUp {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  title         String
  relatedPerson String?   @map("related_person")
  dueDate       DateTime? @map("due_date")
  status        String    @default("open") // open | done | overdue
  notes         String?
  user          User      @relation(fields: [userId], references: [id])

  @@map("follow_ups")
}

model AgentRun {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  command     String
  agentAction String   @map("agent_action")
  result      String?
  status      String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("agent_runs")
}

model AiUsageLog {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  command             String
  model               String
  inputTokens         Int      @default(0) @map("input_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  apiCallCount        Int      @default(1) @map("api_call_count")
  estimatedCostUsd    Decimal  @db.Decimal(12, 8) @map("estimated_cost_usd")
  durationMs          Int      @map("duration_ms")
  createdAt           DateTime @default(now()) @map("created_at")
  user                User     @relation(fields: [userId], references: [id])

  @@map("ai_usage_logs")
}
